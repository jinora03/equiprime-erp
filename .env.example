# Equiprime ERP — Frontend environment template
# Copy to `.env` (or `.env.local`). All values are optional for the web demo.

# Display name used in the UI
VITE_APP_NAME="Equiprime ERP"

# Base URL for the API. With the Vite dev proxy, "/api/v1" is forwarded to the
# FastAPI backend on http://127.0.0.1:8000.
VITE_API_BASE_URL="/api/v1"

# When "true" (default), all data is served from the in-browser mock layer and
# the app runs fully standalone — no backend required. Set to "false" to call
# the real FastAPI backend instead.
VITE_USE_MOCK="true"
